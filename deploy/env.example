# Production environment variables
# Copy to .env on the server and fill in values.

NODE_ENV=production
PORT=5000
HOST=127.0.0.1

# Supabase Auth (required for login/signup and video history)
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-side Supabase URL (same as VITE_SUPABASE_URL but without VITE_ prefix)
SUPABASE_URL=https://your-project.supabase.co
# JWT Secret for backend verification: Project Settings → API → JWT Secret (Legacy JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret
